python3 -c "\
import json, sys\
with open('$HOME/.config/quickshell/app_icons.json') as f:\
    data = json.load(f)\
\
def get_icon(class_name):\
    lower = class_name.lower()\
    for app in data['apps']:\
        if app['name'] and lower.find(app['name']) != -1:\
            return app['icon']\
        for alias in app.get('aliases', []):\
            if lower.find(alias) != -1:\
                return app['icon']\
    return 'none'\
\
# Test with some known class names\
tests = ['firefox', 'org.mozilla.firefox', 'code', 'kitty', 'zen']\
for t in tests:\
    print(t, '->', get_icon(t))\
"
