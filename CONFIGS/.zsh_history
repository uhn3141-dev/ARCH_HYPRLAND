: 1779778898:0;# Check if battery exists\
ls /sys/class/power_supply/\
\
# Check what files are available\
ls /sys/class/power_supply/BAT*/ 2>/dev/null\
\
# Check for power_now (power draw in microwatts)\
cat /sys/class/power_supply/BAT*/power_now 2>/dev/null\
\
# Check for voltage_now (in microvolts)\
cat /sys/class/power_supply/BAT*/voltage_now 2>/dev/null\
\
# Check for energy_now (current charge in micro-watt-hours)\
cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null\
\
# Check for energy_full (full capacity)\
cat /sys/class/power_supply/BAT*/energy_full 2>/dev/null\
\
# Check for charge_now (alternative to energy_now)\
cat /sys/class/power_supply/BAT*/charge_now 2>/dev/null
