\
# Put your AirPods in pairing mode (open the case with AirPods inside, press and hold the button on the back until the light flashes white)\
\
# Start scanning for devices\
bluetoothctl scan on\
\
# Wait until you see your AirPods appear in the scan results, then pair with them\
bluetoothctl pair 41:42:50:99:C6:92\
\
# After pairing, trust the device\
bluetoothctl trust 41:42:50:99:C6:92\
\
# Now try connecting\
bluetoothctl connect 41:42:50:99:C6:92\
\
# Stop scanning\
bluetoothctl scan off
