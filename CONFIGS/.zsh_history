: 1779791381:0;cat > /home/uhn406/.config/quickshell/popups/Battery/desktop_cache.py << 'PYEOF'\
#!/usr/bin/env python3\
"""Build desktop application cache for name and icon resolution"""\
\
import os\
import json\
\
CACHE_FILE = "/home/uhn406/.config/quickshell/popups/Battery/desktop_cache.json"\
\
def get_xdg_search_dirs():\
    search_dirs = []\
    xdg_data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))\
    search_dirs.append(os.path.join(xdg_data_home, "applications"))\
    \
    xdg_data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")\
    for d in xdg_data_dirs.split(":"):\
        if d.strip():\
            search_dirs.append(os.path.join(d.strip(), "applications"))\
    return search_dirs\
\
def build_cache():\
    cache = {}\
    count = 0\
    \
    for directory in get_xdg_search_dirs():\
        if not os.path.exists(directory):\
            continue\
        for f in os.listdir(directory):\
            if not f.endswith(".desktop"):\
                continue\
            path = os.path.join(directory, f)\
            try:\
                name = None\
                icon = ""\
                wmclass = None\
                \
                with open(path, 'r', encoding='utf-8', errors='ignore') as file:\
                    for line in file:\
                        line = line.strip()\
                        if line.startswith("Name=") and not name:\
                            name = line.split("=", 1)[1].strip()\
                        elif line.startswith("Icon=") and icon == "":\
                            icon = line.split("=", 1)[1].strip()\
                        elif line.startswith("StartupWMClass="):\
                            wmclass = line.split("=", 1)[1].strip().lower()\
                \
                if name:\
                    base = f[:-8].lower()\
                    cache[base] = {"name": name, "icon": icon}\
                    count += 1\
                    if wmclass:\
                        cache[wmclass] = {"name": name, "icon": icon}\
                        count += 1\
            except Exception as e:\
                pass\
    \
    os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)\
    with open(CACHE_FILE, 'w', encoding='utf-8') as f:\
        json.dump(cache, f, indent=2)\
    \
    print(f"Cache built: {count} entries from {len(cache)} keys")\
\
if __name__ == "__main__":\
    build_cache()\
PYEOF\
\
# Run it\
python3 /home/uhn406/.config/quickshell/popups/Battery/desktop_cache.py\
\
# Check\
ls -la /home/uhn406/.config/quickshell/popups/Battery/desktop_cache.json\
head -10 /home/uhn406/.config/quickshell/popups/Battery/desktop_cache.json
