: 1779702887:0;# Create the config directory\
mkdir -p ~/.config/pipewire/client.conf.d/\
\
# Create a permission file\
cat > ~/.config/pipewire/client.conf.d/99-permissions.conf << 'EOF'\
context.modules = [\
    {   name = libpipewire-module-access\
        args = {\
            access.allow = [\
                { application = "pactl" }\
                { application = "pipewire-pulse" }\
            ]\
        }\
    }\
]\
EOF\
\
# Restart PipeWire\
systemctl --user restart pipewire pipewire-pulse
