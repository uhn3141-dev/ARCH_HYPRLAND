: 1779618905:0;# Get your ethernet device name\
ETH_DEV=$(ls /sys/class/net/e* 2>/dev/null | head -1 | xargs basename)\
\
# Read current bytes\
cat /proc/net/dev | grep "$ETH_DEV" | awk '{print "Down:", $2, "Up:", $10}'\
\
# Wait 2 seconds\
sleep 2\
\
# Read again to see the difference\
cat /proc/net/dev | grep "$ETH_DEV" | awk '{print "Down:", $2, "Up:", $10}'
: 1779618936:0;# Get ethernet device name\
ETH_DEV=$(ls /sys/class/net/e* 2>/dev/null | head -1 | xargs basename)\
echo "Device: $ETH_DEV"\
\
# Read from /proc/net/dev - the interface name has a colon\
cat /proc/net/dev | grep "$ETH_DEV:"\
\
# Or use awk directly\
cat /proc/net/dev | awk -v dev="$ETH_DEV" '$0 ~ dev {print "Down:", $2, "Up:", $10}'
: 1779618957:0;# Get ethernet device name - only directories, not files\
ETH_DEV=$(ls -1d /sys/class/net/e*/ 2>/dev/null | head -1 | xargs basename)\
echo "Device: $ETH_DEV"\
\
# Read speeds\
cat /proc/net/dev | grep "$ETH_DEV" | awk '{print "Down:", $2, "Up:", $10}'
