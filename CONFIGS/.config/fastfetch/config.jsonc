{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo":
        {
        "source": "~/.config/fastfetch/arch.png",
        "type": "kitty",
        "preserveAspectRatio": true
        },
    "display": {
        "separator": " 󰑃  "
    },
    "modules": [
        "break",

        {
            "type": "custom",
            "format": " {#31}  {#32}  {#33}  {#34}  {#35}  {#36}     {#36}  {#35}  {#34}  {#33}  {#32}  {#31} "
        },

        "break",
        
        {
            "type": "title",
            "key": "╭─",
            "format": "{user-name}@{host-name}",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "os",
            "key": "├─󰣇",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "├─",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "de",
            "key": "├─",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "wm",
            "key": "├─",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "lm",
            "key": "├─󰧨",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "shell",
            "key": "├─",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "├─",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },
        {
            "type": "version",
            "key": "╰─",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },


        "break",

        {
            "type": "host",
            "key": "╭─󰌢",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "chassis",
            "key": "├─󰇅",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "cpu",
            "key": "├─󰻠",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "gpu",
            "key": "├─󰍛",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "memory",
            "key": "├─󰑭",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "swap",
            "key": "├─󰓡",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "display",
            "key": "├─󰍹",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "physicaldisk",
            "key": "├─",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "disk",
            "key": "├─",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "battery",
            "key": "├─",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "poweradapter",
            "key": "├─",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "gamepad",
            "key": "├─",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "bluetooth",
            "key": "├─",
            "keyColor": "blue",
            "outputColor": "blue"
        },
        {
            "type": "sound",
            "key": "╰─",
            "keyColor": "blue",
            "outputColor": "blue"
        },

        "break",
        
        {
            "type": "packages",
            "key": "╭─󰏖",
            "keyColor": "green",
            "outputColor": "green"
        },
        {
            "type": "uptime",
            "key": "├─󰅐",
            "keyColor": "green",
            "outputColor": "green"
        },
        {
            "type": "wifi",
            "key": "├─",
            "format": "{ssid}",
            "keyColor": "green",
            "outputColor": "green"
        },
        {
            "type": "localip",
            "key": "├─󰩟",
            "compact": true,
            "keyColor": "green",
            "outputColor": "green"
        },
        {
            "type": "publicip",
            "key": "╰─󰩠",
            "keyColor": "green",
            "outputColor": "green",
            "timeout": 1000
        },
        
        "break",

        {
            "type": "theme",
            "key": "╭─󰉼",
            "keyColor": "magenta",
            "outputColor": "magenta"
        },
        {
            "type": "icons",
            "key": "├─󰀻",
            "keyColor": "magenta",
            "outputColor": "magenta"
        },
        {
            "type": "font",
            "key": "╰─",
            "keyColor": "magenta",
            "outputColor": "magenta"
        },

        "break",

        {
            "type": "custom",
            "format": " {#31}  {#32}  {#33}  {#34}  {#35}  {#36}     {#36}  {#35}  {#34}  {#33}  {#32}  {#31} "
        }
    ]
}
